# =============================================================================
# Olife — environment variable template
# Copy to .env for local use. Set the same keys in Railway (staging + production).
# NEVER commit real values.
# =============================================================================

# --- Django core ---
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=olife1.com,www.olife1.com,staging.olife1.com,.up.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://olife1.com,https://www.olife1.com,https://staging.olife1.com
SECURE_SSL_REDIRECT=True
# Local only — never true on Railway staging/prod
ALLOW_SQLITE=false
SEED_ON_BOOT=false
# Optional Railway-injected host
RAILWAY_PUBLIC_DOMAIN=

# --- Database (Supabase Postgres only for app data) ---
DATABASE_URL=postgres://postgres.<SUPABASE_PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres?sslmode=require

# --- Supabase Storage / API ---
SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_STORAGE_BUCKET=media

# --- Feature flags ---
FEATURE_GOOGLE_LOGIN=false
FEATURE_COMMENTS=true
FEATURE_GA4=false
FEATURE_STORE=true
FEATURE_NEWSLETTER=true
FEATURE_AGENTS=false

# --- Auth (django-allauth Google) — plumbing only until FEATURE_GOOGLE_LOGIN=true ---
GOOGLE_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_OAUTH_CLIENT_SECRET>
ACCOUNT_DEFAULT_HTTP_PROTOCOL=https
SITE_ID=1

# --- Email (contact notifications, allauth) ---
DEFAULT_FROM_EMAIL=Olife <noreply@olife1.com>
CONTACT_NOTIFY_EMAIL=<OWNER_EMAIL>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- reCAPTCHA (optional; replace Formspree-era keys) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Store stub ---
STORE_URL=https://example.com/shop-placeholder

# --- Podcast / video embeds (comma-separated URLs OK) ---
PODCAST_YOUTUBE_URLS=
PODCAST_SPOTIFY_URLS=

# --- GA4 ---
GA4_MEASUREMENT_ID=G-XXXXXXXX
GA4_PROPERTY_ID=<GA4_NUMERIC_PROPERTY_ID>
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Or path-based creds in local/dev only:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# --- LLM (Gemini primary; others optional fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_DEFAULT_MODEL=gemini-flash
LLM_PRO_MODEL=gemini-pro
LLM_ALLOW_PRO=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Non-secret routing lives in config/llm.yaml

# --- Agent / control plane (Telegram primary + /admin/commands/ backup; no Google Chat) ---
AGENT_APPROVE_BUILD=false
AGENT_AUTONOMY_STAGING=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Railway / GitHub (agent Deployer; prefer OIDC/CLI login over PATs when possible) ---
RAILWAY_TOKEN=
GITHUB_TOKEN=
GIT_AUTHOR_NAME=Olife Agent
GIT_AUTHOR_EMAIL=agent@olife1.com

# --- Legacy (remove after Phase 2 contact migration) ---
# FORMSPREE_ENDPOINT=
